{
  "manifest_version": "0.3",
  "name": "dynoxide",
  "version": "1.0.0",
  "description": "A DynamoDB emulator with an MCP server exposing 35 DynamoDB tools to coding agents.",
  "author": {
    "name": "Martin Hicks",
    "url": "https://dynoxide.dev"
  },
  "server": {
    "type": "binary",
    "entry_point": "npx",
    "mcp_config": {
      "command": "npx",
      "args": ["-y", "dynoxide", "mcp"],
      "env": {}
    }
  },
  "tools": []
}
